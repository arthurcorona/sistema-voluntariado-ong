# Copie para .env.local e preencha. Nunca versione o .env.local.
# Valores em: Supabase > Project Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://SEU-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Não é necessária nesta fase. Só descomente se alguma rotina de servidor
# precisar ignorar RLS (não deve).
# SUPABASE_SERVICE_ROLE_KEY=

# Teste de ponta a ponta (npm run e2e). Só no projeto de desenvolvimento.
# E2E_BASE_URL=http://localhost:3000
# E2E_EMAIL=teste@example.com
# E2E_SENHA=
# E2E_PERMITIR_RESET=sim   # habilita npm run e2e:reset, que APAGA todos os dados
